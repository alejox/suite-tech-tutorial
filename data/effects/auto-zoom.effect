// Auto-zoom + Smart Cursor effect.
// The vertex shader maps the output quad onto the zoomed region of the
// source texture; the pixel shader draws the cursor halo and click ripples
// in source space, so they zoom together with the image.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_scale;
uniform float2 uv_offset;
uniform float2 source_size;   // source size in pixels

uniform float2 halo_pos;      // normalized source coordinates
uniform float  halo_radius;   // pixels
uniform float4 halo_color;    // alpha = opacity

uniform float2 ripple_pos;
uniform float  ripple_radius; // pixels
uniform float  ripple_width;  // pixels
uniform float4 ripple_color;  // alpha already faded over time

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSZoom(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv * uv_scale + uv_offset;
	return vert_out;
}

float4 PSZoom(VertData v_in) : TARGET
{
	float4 color = image.Sample(textureSampler, v_in.uv);
	float2 px = v_in.uv * source_size;

	// Soft spotlight around the cursor.
	if (halo_color.a > 0.0) {
		float d = distance(px, halo_pos * source_size);
		float a = halo_color.a * (1.0 - smoothstep(halo_radius * 0.6, halo_radius, d));
		color.rgb = lerp(color.rgb, halo_color.rgb, a);
	}

	// Expanding ring on click.
	if (ripple_color.a > 0.0) {
		float d = distance(px, ripple_pos * source_size);
		float ring = 1.0 - smoothstep(0.0, ripple_width, abs(d - ripple_radius));
		color.rgb = lerp(color.rgb, ripple_color.rgb, ring * ripple_color.a);
	}

	return color;
}

technique Draw
{
	pass
	{
		vertex_shader = VSZoom(v_in);
		pixel_shader  = PSZoom(v_in);
	}
}
